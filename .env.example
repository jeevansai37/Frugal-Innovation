# Copy this file to .env and set your local demo values.
DATABASE_URL=
SECRET_KEY=replace-with-a-long-random-value
# ADMIN_PASSWORD is retained for rollback reference; individual staff routes do not use it.
APP_BASE_URL=http://localhost:5000
# Optional: PostgreSQL connection pool cap per warm instance (default 5).
DB_POOL_MAX_SIZE=5
# Configure the authoritative institutional email domains; no wildcard is accepted.
INSTITUTIONAL_EMAIL_DOMAINS=
# Optional shared throttle key. Defaults to SECRET_KEY, which must be stable on Vercel.
LOGIN_RATE_LIMIT_SECRET=
